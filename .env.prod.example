# .env.prod로 복사하고 운영 환경에 맞는 값을 채우세요.
POSTGRES_DB=webmaster
POSTGRES_USER=webmaster
POSTGRES_PASSWORD=

# 위 DB 이름과 사용자, 같은 비밀번호를 사용하세요.
# 형식: postgresql+asyncpg://webmaster:URL인코딩된비밀번호@db:5432/webmaster
DATABASE_URL=

# 호스트의 127.0.0.1에서만 API에 접근할 수 있습니다.
STARTPRESS_API_PORT=18000

# Google·Bing 인증은 사이트에 연결된 auth_accounts의 파일 참조로 선택합니다.
# /home/ubuntu/webmaster-secrets/google/<이메일>.json: Google OAuth JSON
# /home/ubuntu/webmaster-secrets/bing/<이메일>.json: {"api_key": "..."}
# DB에는 google/<이메일>.json, bing/<이메일>.json 상대 경로만 등록하세요.
