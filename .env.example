GOOGLE_OAUTH_CLIENT_FILE=.secrets/google_search_console_api_user_oauthjson
GOOGLE_TOKEN_FILE=.secrets/google-token.json
BING_API_KEY=

# Google Search Console 브라우저 로그인용 Google 계정입니다.
# Bing도 Google 계정 로그인을 사용하므로 같은 인증정보를 사용합니다.
# OAuth JSON·토큰 및 BING_API_KEY와 별개이며, 실행 코드에서 LoginCredentials에 주입합니다.
GOOGLE_LOGIN_ID=
GOOGLE_LOGIN_PASSWORD=

# 로컬 개발용 PostgreSQL 설정입니다. 실제 비밀번호는 .env에만 저장합니다.
POSTGRES_DB=webmaster
POSTGRES_USER=webmaster
POSTGRES_PASSWORD=

# FastAPI의 비동기 SQLAlchemy 연결 단계에서 사용합니다.
# 형식: postgresql+asyncpg://사용자:URL인코딩된비밀번호@127.0.0.1:5432/DB이름
DATABASE_URL=

# Discord 인증봇: Bot 메뉴의 토큰과 숫자 ID를 설정합니다.
# APPLICATION_ID / PUBLIC_KEY는 현재 Gateway 연결 확인에 필요하지 않습니다.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
