{
  "manifest_version": 3,
  "minimum_chrome_version": "118",
  "name": "StartPress Console",
  "version": "0.1.1",
  "description": "고객사 사이트와 글 URL의 검색엔진 상태를 관리합니다.",
  "permissions": ["debugger"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "StartPress 관리 화면 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://searchadvisor.naver.com/*"
      ],
      "js": [
        "naver-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.bing.com/webmasters",
        "https://www.bing.com/webmasters/*"
      ],
      "js": [
        "bing-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://searchadvisor.naver.com/*",
    "https://search.google.com/*",
    "https://www.bing.com/*"
  ]
}
