{
  "name": "startpress-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
